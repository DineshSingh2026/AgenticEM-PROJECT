# Resend (briefing + sandbox requests). If RESEND_API_KEY is empty, /api/briefing logs and returns { ok: true, dev: true }.
RESEND_API_KEY=
# Inbox that receives briefing requests
BRIEFING_TO_EMAIL=briefings@example.com
# Verified Resend sender, also used for the auto-reply
BRIEFING_FROM_EMAIL="AGENTIUM <no-reply@example.com>"
# Canonical site origin (sitemap, robots, canonicals, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional WebSocket feed replacing the seeded simulator
NEXT_PUBLIC_FEED_URL=
